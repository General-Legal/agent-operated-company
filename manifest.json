{
  "name": "agent-operated-company",
  "description": "Free templates and instructions to form a U.S. company an AI agent can operate. An engaged client can have General Legal file it through its MCP.",
  "maintainer": "General Legal, LLP",
  "version": "0.6.0",
  "entities_supported": [
    "LLC",
    "C-Corporation"
  ],
  "default_jurisdiction": "Delaware",
  "mcp": {
    "endpoint": "https://mcp.general.legal/mcp",
    "model": "A formation tool is being added to General Legal's existing MCP.",
    "transport": "streamable-http",
    "auth": "OAuth 2.1 with automatic discovery; a General Legal account is required.",
    "engagement_gate": "The human accepts the clickthrough Limited Engagement Letter when signing in or registering at https://portal.general.legal.",
    "attorney_in_the_loop": "An attorney reviews and approves before any filing.",
    "free_access": "The templates and filing instructions are freely readable without an account or MCP connection."
  },
  "template_contract": {
    "authoritative_format": "docx",
    "substitution_syntax": "{Field Name}",
    "company_name": "The full legal name, including the entity suffix and punctuation.",
    "pandadoc_field_tag_syntax": "{signature:role_____}",
    "packet_rule": "Upload all templates for the selected entity as one ordered execution packet; file only the template whose filed_with_state value is true."
  },
  "recipient_roles": {
    "incorporator": {
      "description": "The C-corporation incorporator.",
      "default_email": "shane@general.legal",
      "signing_order": 1
    },
    "authorized-person": {
      "description": "The person authorized to execute the LLC Certificate of Formation.",
      "default_email": "shane@general.legal",
      "signing_order": 1
    },
    "founder": {
      "description": "The founder, purchaser, and sole stockholder.",
      "signing_order": 2
    },
    "director": {
      "description": "The sole director.",
      "signing_order": 2
    },
    "officer": {
      "description": "The President and Chief Executive Officer, Secretary, Treasurer, and AI Oversight Officer.",
      "signing_order": 2
    },
    "member": {
      "description": "The sole LLC member, purchaser, manager, and AI Oversight Officer.",
      "signing_order": 2
    }
  },
  "templates": [
    {
      "id": "coi-ccorp",
      "title": "Certificate of Incorporation (C-corp, single class)",
      "path": "templates/certificate-of-incorporation-ccorp.docx",
      "entity": "C-Corporation",
      "packet_order": 1,
      "filed_with_state": true,
      "recipient_roles": ["incorporator"],
      "substitution_fields": ["Company Name", "Company Name Upper", "Effective Date", "Registered Office Address", "Registered Agent Name", "Incorporator Name", "Incorporator Address"]
    },
    {
      "id": "action-of-incorporator-ccorp",
      "title": "Action of Incorporator (C-corp)",
      "path": "templates/action-of-incorporator-ccorp.docx",
      "entity": "C-Corporation",
      "packet_order": 2,
      "filed_with_state": false,
      "recipient_roles": ["incorporator"],
      "substitution_fields": ["Company Name", "Company Name Upper", "Effective Date", "Director Name", "Incorporator Name"]
    },
    {
      "id": "bylaws-ccorp",
      "title": "Bylaws (C-corp)",
      "path": "templates/bylaws-ccorp.docx",
      "entity": "C-Corporation",
      "packet_order": 3,
      "filed_with_state": false,
      "recipient_roles": ["officer"],
      "substitution_fields": ["Company Name", "Company Name Upper", "Effective Date", "Officer Name"]
    },
    {
      "id": "org-resolutions-ccorp",
      "title": "Organizational Resolutions (C-corp)",
      "path": "templates/organizational-resolutions-ccorp.docx",
      "entity": "C-Corporation",
      "packet_order": 4,
      "filed_with_state": false,
      "recipient_roles": ["director"],
      "substitution_fields": ["Company Name", "Company Name Upper", "Effective Date", "Principal Office Address", "Founder Name", "Director Name", "Officer Name"]
    },
    {
      "id": "stock-purchase-ccorp",
      "title": "Common Stock Purchase Agreement (C-corp)",
      "path": "templates/common-stock-purchase-agreement-ccorp.docx",
      "entity": "C-Corporation",
      "packet_order": 5,
      "filed_with_state": false,
      "recipient_roles": ["officer", "founder"],
      "substitution_fields": ["Company Name", "Company Name Upper", "Effective Date", "Founder Name", "Officer Name"]
    },
    {
      "id": "indemnification-ccorp",
      "title": "Indemnification Agreement (C-corp)",
      "path": "templates/indemnification-agreement-ccorp.docx",
      "entity": "C-Corporation",
      "packet_order": 6,
      "filed_with_state": false,
      "recipient_roles": ["officer", "director"],
      "substitution_fields": ["Company Name", "Company Name Upper", "Effective Date", "Director Name", "Officer Name"]
    },
    {
      "id": "stockholder-consent-ccorp",
      "title": "Stockholder Consent (C-corp, sole stockholder)",
      "path": "templates/stockholder-consent-ccorp.docx",
      "entity": "C-Corporation",
      "packet_order": 7,
      "filed_with_state": false,
      "recipient_roles": ["founder"],
      "substitution_fields": ["Company Name", "Company Name Upper", "Effective Date", "Director Name", "Founder Name"]
    },
    {
      "id": "ai-governance-policy-ccorp",
      "title": "AI Governance Policy (C-corp)",
      "path": "templates/ai-governance-policy-ccorp.docx",
      "entity": "C-Corporation",
      "packet_order": 8,
      "filed_with_state": false,
      "recipient_roles": ["director", "officer"],
      "substitution_fields": ["Company Name", "Company Name Upper", "Effective Date", "Director Name", "AI Oversight Officer Name", "AI Agent Description", "Contract Threshold", "Authority Limits"]
    },
    {
      "id": "cof-llc",
      "title": "Certificate of Formation (LLC)",
      "path": "templates/certificate-of-formation-llc.docx",
      "entity": "LLC",
      "packet_order": 1,
      "filed_with_state": true,
      "recipient_roles": ["authorized-person"],
      "substitution_fields": ["Company Name", "Effective Date", "Registered Office Address", "Registered Agent Name", "Authorized Person Name"]
    },
    {
      "id": "operating-agreement-llc",
      "title": "Operating Agreement (LLC)",
      "path": "templates/operating-agreement-llc.docx",
      "entity": "LLC",
      "packet_order": 2,
      "filed_with_state": false,
      "recipient_roles": ["member"],
      "substitution_fields": ["Company Name", "Effective Date", "Member Name"]
    },
    {
      "id": "membership-interest-purchase-llc",
      "title": "Membership Interest Purchase Agreement (LLC)",
      "path": "templates/membership-interest-purchase-agreement-llc.docx",
      "entity": "LLC",
      "packet_order": 3,
      "filed_with_state": false,
      "recipient_roles": ["member"],
      "substitution_fields": ["Company Name", "Effective Date", "Member Name"]
    },
    {
      "id": "indemnification-llc-manager",
      "title": "Indemnification Agreement (LLC Manager)",
      "path": "templates/indemnification-agreement-llc-manager.docx",
      "entity": "LLC",
      "packet_order": 4,
      "filed_with_state": false,
      "recipient_roles": ["member"],
      "substitution_fields": ["Company Name", "Effective Date", "Member Name"]
    },
    {
      "id": "ai-governance-policy-llc",
      "title": "AI Governance Policy (LLC)",
      "path": "templates/ai-governance-policy-llc.docx",
      "entity": "LLC",
      "packet_order": 5,
      "filed_with_state": false,
      "recipient_roles": ["member"],
      "substitution_fields": ["Company Name", "Effective Date", "Member Name", "AI Agent Description", "Contract Threshold", "Authority Limits"]
    }
  ],
  "formation_defaults": {
    "C-Corporation": {
      "authorized_common_shares": 10000000,
      "par_value": "0.00001",
      "founder_shares": 1000000,
      "price_per_share": "0.00001",
      "aggregate_consideration": "10.00",
      "consideration": "cash",
      "fiscal_year_end": "December 31",
      "directors_and_officers_insurance": "may maintain"
    },
    "LLC": {
      "members": 1,
      "management": "manager-managed",
      "membership_interests": 100,
      "ownership_percentage": 100,
      "price_per_interest": "0.10",
      "aggregate_consideration": "10.00",
      "consideration": "cash"
    }
  },
  "filing_steps": [
    "Choose the entity type.",
    "Complete and execute the applicable packet.",
    "File only the Certificate of Incorporation or Certificate of Formation and pay the state fee.",
    "Appoint a registered agent.",
    "Obtain an EIN from the IRS.",
    "Open a separate business bank account and maintain the entity's records."
  ],
  "engagement": {
    "service_fee": "$50 to file a standard single-class LLC or C-corp; the client also pays the state filing fee and registered-agent cost.",
    "engagement_url": "https://portal.general.legal/signup?utm_source=mcp&utm_medium=agent&utm_campaign=agent-operated-company",
    "note": "General Legal is a law firm. The human accepts a clickthrough Limited Engagement Letter, and a supervising attorney reviews before filing."
  },
  "disclaimer": "Informational only; not legal advice; no attorney-client relationship is formed by using the free templates. Engagement forms only through a Limited Engagement Letter after a conflicts check.",
  "formats": {
    "docx": "Authoritative Word documents prepared for literal substitution and PandaDoc field-tag parsing."
  }
}
